# NEXAI website — environment variables.
# On Coolify (n8n host, Hetzner DE) paste these under the app's "Environment Variables".
# Everything except NEXT_PUBLIC_SITE_URL is a RUNTIME secret (mark them as such, not "Build").

# Public site origin — BUILD-time variable (inlined into the client bundle).
# In Coolify: mark this one as a "Build Variable". Use the canonical https origin.
NEXT_PUBLIC_SITE_URL=https://www.nex-a-i.com

# --- Email delivery (Resend) ---
RESEND_API_KEY=
CONTACT_TO=mbt@nex-a-i.com
CONTACT_FROM=NEXAI <noreply@nex-a-i.com>
# Empfänger für Vertriebspartner-Bewerbungen (/api/apply); leer = CONTACT_TO
APPLY_TO=

# --- CRM lead sink (self-hosted CRM, Hetzner DE) ---
CRM_API_URL=https://crm.nex-a-i.com
CRM_API_KEY=

# --- n8n chat webhook (chatbot proxy) ---
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_SECRET=

# --- n8n booking webhook (Terminbuchung) ---
N8N_BOOKING_WEBHOOK_URL=
N8N_BOOKING_SECRET=

# --- Newsletter double-opt-in token secret (falls back to RESEND_API_KEY if unset) ---
NEWSLETTER_SECRET=

# --- Texteditor unter /admin (siehe ADMIN.md) ---
# Ohne die ersten beiden ist /admin abgeschaltet.
# Hash erzeugen: node scripts/admin-password.mjs "passwort"
# Achtung: Trennzeichen ist der Doppelpunkt — ein "$" würde als Variable ersetzt.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Fine-grained Token, nur dieses Repository, Contents: Read and write.
GITHUB_TOKEN=
# Optional, das sind die Vorgaben:
# GITHUB_REPO=maximiliantrenk-wq/NexAI-Website
# GITHUB_BRANCH=main

# Optional: schaltet den "Veröffentlichen"-Knopf frei (sonst Redeploy von Hand).
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_APP_UUID=
