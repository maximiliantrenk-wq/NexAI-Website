    {
      "parameters": {
        "jsCode": "const p = $('Parse & Normalize').first().json;\nconst wohin = p.rueckrufnummer ? ('unter ' + p.rueckrufnummer) : ('per E-Mail an ' + p.email);\nconst result = 'Der Rückrufwunsch ist notiert und das Team wurde benachrichtigt. Bestätige dem Anrufer kurz, dass sich ein Kollege zeitnah ' + wohin + ' meldet, und verabschiede dich freundlich.';\nreturn [{ json: { results: [{ toolCallId: p.toolCallId, result }] } }];"
      },
      "id": "code-r4",
