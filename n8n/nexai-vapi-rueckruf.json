    {
      "parameters": {
        "jsCode": "// NEXAI Voice · Rückruf-Wunsch — Payload lesen (flach ODER Vapi-Envelope)\nconst TZ = 'Europe/Berlin';\n\nconst root = $input.first().json || {};\nconst body = (root.body && typeof root.body === 'object') ? root.body : root;\nlet toolCallId = '';\nlet a = {};\nif (body && body.message && Array.isArray(body.message.toolCalls) && body.message.toolCalls[0]) {\n  const tc = body.message.toolCalls[0];\n  toolCallId = tc.id || '';\n  let ar = tc.function && tc.function.arguments;\n  if (typeof ar === 'string') { try { ar = JSON.parse(ar); } catch (e) { ar = {}; } }\n  a = ar || {};\n} else {\n  a = body || {};\n  toolCallId = body.toolCallId || '';\n}\n\n// Anrufernummer aus dem Vapi-Envelope — nur bei echten Telefonanrufen gesetzt, bei Web-Calls leer\nlet callerNumber = '';\ntry { callerNumber = String(body.message.call.customer.number || '').trim(); } catch (e) { callerNumber = ''; }\n\nconst name = String(a.name != null ? a.name : '').trim();\nconst email = String(a.email != null ? a.email : '').trim();\nconst telefon = String((a.telefon != null ? a.telefon : a.phone) || '').trim();\nconst anliegen = String((a.anliegen != null ? a.anliegen : a.topic) || '').trim();\nconst dringlichkeit = String((a.dringlichkeit != null ? a.dringlichkeit : a.urgency) || '').trim();\n\n// Rückrufnummer: was der Anrufer nennt, sonst die Nummer, von der er anruft\nconst rueckrufnummer = telefon || callerNumber;\nconst valid = Boolean(rueckrufnummer || email);\n\nconst eingegangen = $now.setZone(TZ).toFormat('dd.LL.yyyy HH:mm');\n\nreturn [{ json: { valid, toolCallId, name, email, telefon, callerNumber, rueckrufnummer, anliegen, dringlichkeit, eingegangen } }];"
      },
